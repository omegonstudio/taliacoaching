# Credencial de Mercado Pago (test o producción). Solo servidor — nunca exponer al cliente.
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token
# Alias aceptado: MP_ACCESS_TOKEN

# URL pública del sitio con HTTPS (requerido por Mercado Pago en back_urls).
# En Vercel podés omitirla si VERCEL_URL está disponible; en local usá un túnel (ngrok, etc.).
SITE_URL=https://tu-dominio.vercel.app
